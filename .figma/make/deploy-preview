#!/usr/bin/env bash
set -euo pipefail

build_dir=".figma-build"
rm -rf "$build_dir"
mkdir -p "$build_dir"
cp -R -- \
  index.html \
  style.css \
  home.css \
  logo.ico \
  fantasyx.html \
  gallery.html \
  ./*.pdf \
  apks \
  apps \
  exes \
  games \
  screenshots \
  websites \
  "$build_dir/"

[[ -f "$build_dir/index.html" ]] || {
  echo "Expected static site output at $build_dir" >&2
  exit 1
}

figma make deploy-preview --build-dir "$build_dir"
